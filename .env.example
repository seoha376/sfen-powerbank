VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never expose these values through VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local projects may use the legacy service-role key instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SFEN_ADMIN_ID=
SFEN_ADMIN_NAME=
SFEN_ADMIN_EMAIL=
SFEN_ADMIN_PASSWORD=

# Server-only operational gate. Keep false in production unless explicitly enabled.
SFEN_DEMO_MODE_ALLOWED=false
